{
    "name": "140medley",
    "title": "140medley",
    "description": "A micro-framework or a collection of small, helpful utilities for common javascript tasks.",
    "version": "1.0.0",
    "homepage": "https://github.com/frkr/140medley",
    "licenses": [
        {
            "type": "BSD",
            "url": "https://github.com/frkr/140medley/blob/master/LICENSE"
        }
    ],
    "keywords": [
        "micro",
        "template",
        "event",
        "event",
        "storage",
        "dom",
        "selector"
    ],
    "author": [
        {
            "name": "Davi Saranszky Mesquita",
            "email": "davimesquita@gmail.com"
        },
        {
            "name": "Honza Pokorny",
            "email": "me@honza.ca"
        },
        {
            "name": "Jed Schmidt",
            "email": "where@jed.is"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/frkr/140medley.git"
    },
    "bugs": {
        "url": "https://github.com/frkr/140medley/issues"
    },
    "devDependencies": {
        "coffeescript": "^2.7.0",
        "grunt": "^1.5.3",
        "grunt-contrib-concat": "^1.0.1",
        "grunt-contrib-connect": "^2.1.0",
        "grunt-contrib-jshint": "^3.2.0",
        "grunt-contrib-qunit": "^4.0.0",
        "grunt-contrib-uglify": "^5.2.2",
        "grunt-contrib-watch": "^1.1.0",
        "nyc": "^17.1.0",
        "puppeteer-to-istanbul": "^1.4.0"
    },
    "main": "dist/140medley.js",
    "engines": {
        "node": ">=0.8.0"
    },
    "scripts": {
        "test": "node run-tests.js",
        "serve": "node -e \"require('http').createServer((req, res) => { const path = req.url.slice(1); require('fs').createReadStream(path).pipe(res); }).listen(8000)\"",
        "coverage": "node run-tests.js && nyc report --reporter=text-summary --reporter=lcov"
    },
    "dependencies": {
        "puppeteer": "^24.34.0"
    },
    "nyc": {
        "include": [
            "src/**"
        ],
        "exclude": [
            "node_modules",
            "tests",
            "dist"
        ],
        "reporter": [
            "lcov",
            "text-summary"
        ]
    }
}
